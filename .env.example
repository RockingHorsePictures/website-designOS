# Copy to .env. Use different databases/secrets/storage for local, preview, production.
DATABASE_URL=postgresql://designos:local-only@127.0.0.1:54329/designos
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
SITE_ENV=local
DATABASE_ENV=local
# Schema push is disabled by default; committed migrations are used in every environment.
DB_PUSH=false
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Required on Vercel. Set to preview or production to match SITE_ENV.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# Only used by the explicit demo seed. Never seed production.
SEED_EMAIL=editor@example.test
SEED_PASSWORD=
# Runtime AI is optional and disabled by default.
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=
# HTTPS provider service implementing POST /alt-text (see docs/ARCHITECTURE.md).
AI_MODEL=
AI_DAILY_LIMIT=30
# Hosted sites: protects the one-time /setup page (Deploy Button). Not needed locally.
DESIGNOS_SETUP_CODE=
# Preview deployments only, after enabling Neon preview branches.
DESIGNOS_PREVIEW_DATA=
# Main content language (set before the first deployment).
DESIGNOS_DEFAULT_LOCALE=en
# Sign in with Google (see docs/DEPLOY.md). PASSWORD_SIGN_IN: all | admins | off
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=
PASSWORD_SIGN_IN=all
# Optional Cloudflare Turnstile spam protection for forms.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional SMTP for password resets, invitations and enquiry notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
# Defaults to Site Settings email when empty.
FORM_NOTIFY_EMAIL=
INDEXNOW_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
