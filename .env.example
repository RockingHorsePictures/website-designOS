# Copy to .env. Use different databases/secrets/storage for local, preview, production.
DATABASE_URL=postgresql://designos:local-only@127.0.0.1:54329/designos
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
SITE_ENV=local
DATABASE_ENV=local
# Schema push is disabled by default; committed migrations are used in every environment.
DB_PUSH=false
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Required on Vercel. Set to preview or production to match SITE_ENV.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# Only used by the explicit demo seed. Never seed production.
SEED_EMAIL=editor@example.test
SEED_PASSWORD=
# Runtime AI is optional and disabled by default.
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=
# HTTPS provider service implementing POST /alt-text (see ARCHITECTURE.md).
AI_MODEL=
AI_DAILY_LIMIT=30
INDEXNOW_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
